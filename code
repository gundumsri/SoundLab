<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SoundLab Pro — Advanced Audio Signal Analyzer</title>
<style>
:root{--bg:#080d18;--panel:#111a2b;--panel2:#0d1524;--line:#24334b;--text:#edf4ff;--muted:#91a3bd;--cyan:#48e1d2;--blue:#7095ff;--pink:#f27bbd;--green:#8ce6a2}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 20% -10%,#15294b 0,transparent 45%),var(--bg);color:var(--text);font:14px/1.55 Inter,"Segoe UI",Tahoma,sans-serif}
button,input,select{font:inherit}
button{cursor:pointer;border:1px solid var(--line);background:#1a2940;color:var(--text);padding:9px 13px;border-radius:9px;transition:.18s}
button:hover{border-color:var(--cyan);transform:translateY(-1px)}
button.primary{background:var(--cyan);color:#06201f;border-color:var(--cyan);font-weight:750}
button.danger{background:#3a1d32;border-color:#65314e;color:#ffc3df}
.shell{max-width:1500px;margin:auto;padding:24px}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:25px}
.brand{display:flex;gap:13px;align-items:center}
.logo{width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,var(--cyan),var(--blue));display:grid;place-items:center;color:#06121e;font-size:24px;font-weight:900;box-shadow:0 0 30px #48e1d233}
.eyebrow{font-size:11px;color:var(--cyan);letter-spacing:2px;text-transform:uppercase}
.brand h1{font-size:23px;line-height:1.2;margin:2px 0}
.brand p{margin:4px 0 0;color:var(--muted);font-size:12px}
.top-actions{display:flex;align-items:center;gap:10px}
.status{color:var(--muted);font-size:12px;display:flex;gap:7px;align-items:center}
.dot{width:8px;height:8px;border-radius:50%;background:#62728a}
.dot.live{background:var(--green);box-shadow:0 0 10px var(--green)}
.layout{display:grid;grid-template-columns:225px minmax(0,1fr);gap:22px}
.sidebar,.panel,.metric{background:linear-gradient(145deg,#121d30,#0e1727);border:1px solid var(--line);border-radius:15px}
.sidebar{padding:13px;height:max-content;position:sticky;top:16px}
.side-label{color:#7186a4;font-size:10px;letter-spacing:1.6px;padding:12px 10px 7px}
.nav{width:100%;display:flex;gap:10px;align-items:center;text-align:left;background:transparent;border-color:transparent;color:#aebdd1;margin:2px 0}
.nav.active{background:#1b3044;color:var(--cyan);border-color:#2b5060}
.nav span:first-child{width:22px;text-align:center}
.sidebar-note{border-top:1px solid var(--line);margin-top:14px;padding:14px 9px 5px;color:var(--muted);font-size:11px}
.content{min-width:0}
.pagehead{display:flex;align-items:end;justify-content:space-between;gap:15px;margin:0 0 17px;flex-wrap:wrap}
.pagehead h2{margin:0;font-size:22px}
.pagehead p{margin:5px 0 0;color:var(--muted)}
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:15px}
.metric{padding:15px}
.metric .label{font-size:11px;color:var(--muted)}
.metric .value{font-size:24px;font-weight:750;margin-top:7px;letter-spacing:-.5px}
.metric .unit{font-size:12px;color:var(--muted);font-weight:400}
.metric .hint{font-size:11px;color:var(--green);margin-top:4px}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.panel{padding:17px;margin-bottom:15px;min-width:0}
.panelhead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px}
.panelhead h3{margin:0;font-size:14px}
.sub{font-size:11px;color:var(--muted)}
.chart{width:100%;height:230px;display:block;background:#09111f;border:1px solid #1c2b41;border-radius:10px}
.chart.tall{height:290px}
.controls{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-top:12px}
.field{display:flex;flex-direction:column;gap:5px;min-width:90px;flex:1}
.field label{font-size:11px;color:var(--muted)}
input[type=number],input[type=text],select{width:100%;background:#0a1322;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:9px;min-width:0}
input[type=range]{width:100%;accent-color:var(--cyan)}
.range-line{display:flex;justify-content:space-between;color:var(--muted);font-size:11px}
.hidden{display:none!important}
.pill{font-size:10px;padding:4px 8px;border-radius:20px;background:#172b3a;color:var(--cyan);border:1px solid #254557}
.legend{display:flex;gap:14px;flex-wrap:wrap;color:var(--muted);font-size:11px;margin:8px 0}
.legend i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px}
.tablewrap{overflow:auto}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-weight:500}
td{color:#dce7f6}
.empty{padding:26px;text-align:center;color:var(--muted)}
.lesson{padding:14px;border:1px solid var(--line);border-radius:10px;background:#0b1423;margin-bottom:10px}
.lesson h4{margin:0 0 6px}
.lesson p{margin:0;color:var(--muted)}
.lesson code{color:var(--cyan)}
.notice{border:1px solid #31515d;background:#10252d;color:#b9eee8;padding:11px 13px;border-radius:10px;margin-bottom:15px;font-size:12px}
.foot{color:#6f819c;font-size:11px;text-align:center;padding:18px}
.badge{font-size:11px;color:var(--muted)}
@media(max-width:950px){
.layout{grid-template-columns:1fr}
.sidebar{position:static;display:flex;overflow:auto;gap:4px}
.side-label,.sidebar-note{display:none}
.nav{white-space:nowrap;width:auto;flex:0 0 auto}
.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:600px){
.shell{padding:13px}
.grid2{grid-template-columns:1fr}
.metric .value{font-size:21px}
.brand h1{font-size:18px}
.chart{height:200px}
}
</style>
</head>
<body>
<div class="shell">
<header class="topbar">
<div class="brand">
<div class="logo">∿</div>
<div>
<div class="eyebrow">Audio intelligence suite</div>
<h1>SoundLab <span style="color:var(--cyan)">Pro</span></h1>
<p>Advanced Audio Signal Analyzer · DSP Workbench</p>
</div>
</div>
<div class="top-actions">
<div class="status"><span class="dot" id="statusDot"></span><span id="statusText">ระบบพร้อมใช้งาน</span></div>
<button id="micBtn" class="primary">◉ เปิดไมโครโฟน</button>
</div>
</header>

<div class="layout">
<aside class="sidebar">
<div class="side-label">WORKSPACE</div>
<button class="nav active" data-page="dashboard"><span>◫</span> Dashboard</button>
<button class="nav" data-page="live"><span>∿</span> Live Analyzer</button>
<button class="nav" data-page="generator"><span>⌁</span> Signal Generator</button>
<button class="nav" data-page="filter"><span>▽</span> Digital Filter Lab</button>
<button class="nav" data-page="recorder"><span>◉</span> Audio Recorder</button>
<button class="nav" data-page="noise"><span>〰</span> Noise Analyzer</button>
<button class="nav" data-page="experiment"><span>⚙</span> Experiment Lab</button>
<div class="side-label">INSIGHTS</div>
<button class="nav" data-page="history"><span>◷</span> Experiment History</button>
<button class="nav" data-page="report"><span>⇩</span> Report Generator</button>
<button class="nav" data-page="learn"><span>▤</span> Learning Center</button>
<div class="sidebar-note">DSP TOOLKIT <br><span style="color:#dce7f6">Build · Measure · Understand</span><br><br>การเข้าถึงไมโครโฟนต้องได้รับอนุญาตจากเบราว์เซอร์ และแนะนำให้เปิดผ่าน HTTPS หรือ localhost</div>
</aside>

<main class="content">
<section id="page-dashboard" class="page">
<div class="pagehead">
<div><h2>Real-time Dashboard</h2><p>ภาพรวมสัญญาณเสียงและสถานะระบบ</p></div>
<span class="pill">● LIVE MONITOR</span>
</div>
<div class="notice">เริ่มต้นใช้งานได้ทันทีด้วย Signal Generator หรือกด “เปิดไมโครโฟน” เพื่อวิเคราะห์เสียงจริง ค่าที่แสดงจะอัปเดตเมื่อมีสัญญาณเข้า</div>
<div class="metrics">
<div class="metric"><div class="label">RMS AMPLITUDE</div><div class="value" id="mRms">0.000 <span class="unit">FS</span></div><div class="hint">ระดับสัญญาณเฉลี่ย</div></div>
<div class="metric"><div class="label">PEAK LEVEL</div><div class="value" id="mPeak">0.000 <span class="unit">FS</span></div><div class="hint">ค่าสูงสุดที่ตรวจพบ</div></div>
<div class="metric"><div class="label">DOMINANT FREQ.</div><div class="value" id="mFreq">— <span class="unit">Hz</span></div><div class="hint">ความถี่เด่นโดยประมาณ</div></div>
<div class="metric"><div class="label">SAMPLE RATE</div><div class="value" id="mRate">— <span class="unit">Hz</span></div><div class="hint">AudioContext rate</div></div>
</div>
<div class="grid2">
<div class="panel">
<div class="panelhead"><h3>Live Waveform</h3><span class="sub">TIME DOMAIN</span></div>
<canvas id="wave" class="chart"></canvas>
<div class="legend"><span><i style="background:var(--cyan)"></i>Amplitude</span><span>Buffer: 2048 samples</span></div>
</div>
<div class="panel">
<div class="panelhead"><h3>Frequency Spectrum</h3><span class="sub">FFT · FREQUENCY DOMAIN</span></div>
<canvas id="spectrum" class="chart"></canvas>
<div class="legend"><span><i style="background:var(--blue)"></i>Magnitude</span><span id="fftInfo">FFT bins —</span></div>
</div>
</div>
<div class="panel">
<div class="panelhead"><h3>Quick Signal Generator</h3><span class="pill">WEB AUDIO API</span></div>
<div class="controls">
<div class="field"><label>Waveform</label><select id="quickType"><option value="sine">Sine</option><option value="square">Square</option><option value="sawtooth">Sawtooth</option><option value="triangle">Triangle</option></select></div>
<div class="field"><label>Frequency (Hz)</label><input id="quickFreq" type="number" value="440" min="20" max="20000"></div>
<div class="field"><label>Gain (0–1)</label><input id="quickGain" type="number" value="0.15" min="0" max="1" step="0.05"></div>
<button id="quickPlay" class="primary">▶ Play tone</button><button id="quickStop">■ Stop</button>
</div>
</div>
</section>
